# ==============================================================================
# HITCHINGS - Environment Configuration Template
# ==============================================================================
# Copia este archivo a .env y ajusta los valores según tu entorno local/despliegue.

# General
PROJECT_NAME=HITCHINGS
ENV=development
LOG_LEVEL=INFO

# Web & CORS (Bloque 8B.0 / 8B.1 - Portal Frontend Client)
# Orígenes permitidos para peticiones desde navegador (separados por comas).
# Para desarrollo local con Vite/React/Next:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variables (Vite)
# Si VITE_API_BASE_URL está vacío o no configurado, el portal opera automáticamente en modo mock autónomo
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false

# Database (PostgreSQL 16)
# - Dentro de Docker Compose: postgresql+psycopg://hitchings:hitchings@db:5432/hitchings
# - Fuera de Docker (desde Windows host conectado a Docker): postgresql+psycopg://hitchings:hitchings@localhost:5433/hitchings
DATABASE_URL=postgresql+psycopg://hitchings:hitchings@db:5432/hitchings

# PostgreSQL Container Credentials (usadas por docker-compose.yml)
POSTGRES_USER=hitchings
POSTGRES_PASSWORD=hitchings
POSTGRES_DB=hitchings
POSTGRES_PORT=5433

# ==============================================================================
# PROVIDERS CONFIGURATION (Free-First Policy)
# ==============================================================================
# Las siguientes variables definen límites e integraciones futuras.
# En el Bloque 0 están desactivadas por defecto y no se realiza ninguna llamada externa.

# Bright Data (reservado para futuras fases - LinkedIn)
BRIGHTDATA_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_MONTHLY_LIMIT=5000
BRIGHTDATA_SOFT_LIMIT=4500
BRIGHTDATA_ALLOW_PAID_USAGE=false

# Apify (reservado para futuras fases - fallback)
APIFY_ENABLED=false
APIFY_API_KEY=

# ==============================================================================
# AI ANALYSIS CONFIGURATION (Bloque 7A)
# ==============================================================================
# Por defecto "disabled" para garantizar cero llamadas externas a LLMs.
# Valores soportados: disabled, mock, gemini_api
ANALYSIS_PROVIDER=disabled
ANALYSIS_RELEVANT_MIN_SCORE=70
ANALYSIS_UNCERTAIN_MIN_SCORE=40
ANALYSIS_MONTHLY_ENTRY_LIMIT=1000

# ==============================================================================
# GEMINI DEVELOPER API CONFIGURATION (Bloque 7B)
# ==============================================================================
# Autenticación mediante API Key de Google AI Studio / Gemini Developer API.
# NO introducir API keys reales en este archivo (.env.example).
# En producción (Dokploy/VPS) se configura como variable de entorno secreta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Thinking levels por etapa del pipeline (low/medium/high)
ANALYSIS_TRIAGE_THINKING_LEVEL=low
ANALYSIS_DEEP_THINKING_LEVEL=medium

# Límite de caracteres de entrada por etapa (antes de AnalysisInputTooLarge)
ANALYSIS_TRIAGE_MAX_INPUT_CHARS=250000
ANALYSIS_DEEP_MAX_INPUT_CHARS=250000

# Budget máximo para el benchmark (USD). Hard stop antes de cada nueva Entry.
ANALYSIS_BENCHMARK_MAX_USD=1.00

# Pricing estimado para cálculo de coste del benchmark.
# Corresponde a gemini-3.8-flash en Gemini Developer API (septiembre 2026):
# $0.75 / 1M input tokens, $3.75 / 1M output tokens (incluye reasoning).
# Revisar y actualizar si Google modifica precios o si se cambia de modelo.
# Unidad: USD por 1.000.000 tokens.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0.75
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=3.75

# ==============================================================================
# AUTHENTICATION & SESSIONS (Bloque 8C.1)
# ==============================================================================
AUTH_COOKIE_NAME=hitchings_session
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# ==============================================================================
# GOOGLE NEWS DISCOVERY CONFIGURATION (Bloque 9A)
# ==============================================================================
# Desactivado por defecto para evitar llamadas externas no intencionadas.
GOOGLE_NEWS_ENABLED=false
GOOGLE_NEWS_LANGUAGES=es,en
GOOGLE_NEWS_REGION=ES
GOOGLE_NEWS_MAX_QUERIES_PER_RUN=20
GOOGLE_NEWS_MAX_ITEMS_PER_QUERY=10
GOOGLE_NEWS_MAX_NEW_ENTRIES_PER_RUN=50
GOOGLE_NEWS_TIMEOUT_SECONDS=15.0

